# Copy this file to ".env" and fill in your real values. Never commit ".env".

# Your EXISTING PostgreSQL connection string (same database your old backend used).
# Example: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# The URL of your new frontend (used for CORS). Add more origins in src/app.js if needed.
FRONTEND_URL="http://localhost:5173"

# Port this API server listens on.
PORT=4000

# Web push (browser notifications). Generate your own pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# and keep the same pair forever — rotating it invalidates every browser's
# existing push subscription and everyone has to re-enable push.
VAPID_PUBLIC_KEY="replace-with-your-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
